<%- include('../partials/header', { ws, page, title: (campaign ? 'Edit' : 'New') + ' Campaign - BotGuard' }) %>

<div class="page-header">
  <h1><%= campaign ? 'Edit Campaign' : 'New Campaign' %></h1>
</div>

<form method="POST" action="<%= campaign ? '/admin/campaigns/' + campaign._id : '/admin/campaigns' %>" class="form">
  <div class="form-row">
    <label>Name</label>
    <input type="text" name="name" value="<%= campaign?.name || '' %>" required>
  </div>

  <div class="form-row">
    <label>Slug <span class="muted">(optional — auto-generated from name if empty)</span></label>
    <input type="text" name="slug" value="<%= campaign?.slug || '' %>" pattern="[a-z0-9-]*" placeholder="leave blank to auto-generate">
    <small class="muted">URL will be: <code>/go/&lt;slug&gt;</code>. If the generated slug already exists, a random suffix is appended.</small>
  </div>

  <div class="form-row">
    <label>Custom URL path <span class="muted">(optional)</span></label>
    <%
      const baseUrl = (locals.baseUrl || '').replace(/\/$/, '');
      const rootPath = campaign?.root_path || '';
    %>
    <div style="display:flex; align-items:center; gap:6px;">
      <span class="muted" style="font-family: var(--font-mono); font-size: 13px; white-space: nowrap;"><%= baseUrl || 'https://yourdomain.com' %>/</span>
      <input type="text" name="root_path" id="root_path_input" value="<%= rootPath %>"
             pattern="[a-z0-9][a-z0-9_-]{1,63}"
             maxlength="64"
             placeholder="e.g. promo, black-friday, special-offer">
    </div>
    <small class="muted">
      Lets the campaign be reached at a custom URL like <code><%= baseUrl || 'https://yourdomain.com' %>/promo</code> in addition to <code>/go/&lt;slug&gt;</code>. Leave blank if you only want the default <code>/go/</code> URL.
      <br>Reserved paths like <code>admin</code>, <code>privacy</code>, <code>p</code>, <code>api</code> are blocked. Lowercase letters, digits, hyphens, and underscores only. 2-64 characters.
    </small>
    <% if (rootPath) { %>
      <div style="margin-top: 8px; padding: 8px 12px; background: var(--success-bg); color: var(--success); border-radius: var(--radius-sm); font-size: 13px;">
        Active at: <code style="background:transparent; border:0; color:inherit; padding:0;"><%= baseUrl %>/<%= rootPath %></code>
      </div>
    <% } %>
  </div>

  <div class="form-row form-row-highlight">
    <label style="display:flex; align-items:center; gap:10px; margin-bottom:8px;">
      <strong>Campaign status</strong>
      <% if (campaign?.status === 'active') { %>
        <span class="badge badge-allow">Active</span>
      <% } else if (campaign?.status === 'paused') { %>
        <span class="badge badge-block">Paused</span>
      <% } else if (campaign?.status === 'archived') { %>
        <span class="badge badge-status-archived">Archived</span>
      <% } %>
    </label>
    <select name="status" style="max-width:280px;">
      <option value="active" <%= (!campaign || campaign.status === 'active') ? 'selected' : '' %>>Active — process traffic normally</option>
      <option value="paused" <%= campaign?.status === 'paused' ? 'selected' : '' %>>Paused — send all traffic to safe page</option>
      <option value="archived" <%= campaign?.status === 'archived' ? 'selected' : '' %>>Archived — return 404 (campaign hidden)</option>
    </select>
    <small class="muted" style="display:block; margin-top:8px;">
      <strong>Active</strong> runs the full pipeline (gates, scoring, offer page).<br>
      <strong>Paused</strong> sends every visitor to the safe page with no filtering — clicks are still logged so you can audit traffic. Use this to "switch off" a campaign without deleting it.<br>
      <strong>Archived</strong> makes the <code>/go/<%= campaign?.slug || 'slug' %></code> URL return 404. Use this when retiring a campaign permanently.
    </small>
  </div>

  <div class="form-row form-row-highlight">
    <label style="display:flex; align-items:center; gap:10px; margin-bottom:8px; cursor:pointer;">
      <input type="checkbox" name="indexable" <%= campaign?.indexable ? 'checked' : '' %>>
      <strong>Allow search engines to index this campaign</strong>
      <% if (campaign?.indexable) { %>
        <span class="badge badge-allow">Indexable</span>
      <% } else { %>
        <span class="badge badge-status-archived">Hidden from search</span>
      <% } %>
    </label>
    <small class="muted" style="display:block; margin-top:8px;">
      <strong>Default: off.</strong> Most campaigns are paid-traffic destinations and should not appear in Google/Bing — organic clicks aren't filtered by your gates and could trigger ad-platform quality reviews for cloaking discrepancies.
      <br>
      Turn this <strong>on</strong> for campaigns where organic SEO traffic is desired (evergreen landing pages, content marketing, brand pages). When on:
      <ul style="margin: 4px 0 0 20px; padding: 0;">
        <li>The URL is added to <code>/sitemap.xml</code></li>
        <li><code>/robots.txt</code> emits an <code>Allow:</code> rule for it</li>
        <li>The <code>X-Robots-Tag: noindex</code> header is dropped from responses</li>
      </ul>
      <strong style="color: var(--warning);">Caveat:</strong> indexable campaigns still run through your full filter chain. If gates (country, proxy, UTM) reject Googlebot, crawlers see only the safe page or a 404. Consider relaxing gates for indexable campaigns or setting <code>filter_config.mode</code> to <code>log_only</code>.
    </small>
  </div>

  <div class="form-row">
    <label>Source Profile</label>
    <select name="source_profile">
      <% ['mixed', 'email', 'paid_ads', 'organic', 'affiliate'].forEach(s => { %>
        <option value="<%= s %>" <%= campaign?.source_profile === s ? 'selected' : '' %>><%= s %></option>
      <% }) %>
    </select>
    <small class="muted">Determines how filter scores are weighted. Pick the dominant traffic source for this campaign.</small>
  </div>

  <fieldset>
    <legend style="font-weight:600; padding:0 6px;">Campaign Type</legend>
    <%
      var campType = (campaign && campaign.campaign_type) ? campaign.campaign_type : (typeof presetType !== 'undefined' ? presetType : 'offer');
      var redirDelay = (campaign && campaign.redirect_delay_ms != null) ? campaign.redirect_delay_ms : 1500;
      var ru = (campaign && campaign.redirect_urls) ? campaign.redirect_urls : {};
      // Back-compat: if only the legacy single URL exists, show it as the default.
      var ruDefault = ru.default || (campaign && campaign.redirect_url) || '';
      var devClasses = [['iphone','iPhone'],['android','Android'],['windows','Windows'],['mac','Mac'],['linux','Linux'],['other','Other']];
    %>
    <div class="form-row">
      <label>Type</label>
      <select name="campaign_type" id="campaignType" onchange="document.getElementById('redirectFields').style.display = (this.value==='redirect'?'block':'none');">
        <option value="offer"    <%= campType === 'offer'    ? 'selected' : '' %>>Offer (render landing page)</option>
        <option value="redirect" <%= campType === 'redirect' ? 'selected' : '' %>>Redirect (send clean traffic to a URL)</option>
      </select>
      <small class="muted">Redirect campaigns run the exact same filtering. Filtered traffic still sees the Safe page; only clean traffic is redirected instead of shown an offer page.</small>
    </div>

    <div id="redirectFields" style="display:<%= campType === 'redirect' ? 'block' : 'none' %>;">
      <div class="form-row">
        <label>Default redirect URL</label>
        <input type="url" name="redirect_url_default" value="<%= ruDefault %>" placeholder="https://destination.example/landing" style="width:100%;">
        <small class="muted">Where clean traffic goes when no device-specific URL is set. Must be http(s).</small>
      </div>

      <div class="form-row">
        <label>Device-specific redirect URLs (optional)</label>
        <small class="muted" style="display:block; margin-bottom:8px;">Overrides the default for that device class, exactly like per-device offer/safe pages. Leave blank to use the default.</small>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px;">
          <% devClasses.forEach(function(d){ %>
            <div>
              <label style="font-size:12px; color:var(--text-secondary);"><%= d[1] %></label>
              <input type="url" name="redirect_url_<%= d[0] %>" value="<%= ru[d[0]] || '' %>" placeholder="(use default)" style="width:100%;">
            </div>
          <% }); %>
        </div>
      </div>

      <div class="form-row">
        <label>Redirect delay (ms)</label>
        <input type="number" name="redirect_delay_ms" value="<%= redirDelay %>" min="0" max="15000" step="100" style="width:120px;">
        <small class="muted">Short "redirecting…" screen before the jump. 0 = instant 302 (no interstitial). Max 15000.</small>
      </div>
    </div>
  </fieldset>


  <fieldset>
    <legend style="font-weight:600; padding:0 6px;">Default Pages</legend>
    <p class="muted" style="margin-top:0;">
      Used when no per-device override is set below. The Offer page is shown to allowed visitors;
      the Safe page is shown when a gate fires (UTM / country / proxy / score).
    </p>

    <div class="grid-2">
      <div class="form-row">
        <label>Offer page (default)</label>
        <select name="landing_page_id">
          <option value="">– None (renders stub) –</option>
          <% pages.filter(p => p.kind !== 'safe').forEach(p => { %>
            <option value="<%= p._id %>" <%= campaign?.landing_page_id?.toString() === p._id.toString() ? 'selected' : '' %>>
              <%= p.name %>
            </option>
          <% }) %>
        </select>
      </div>

      <div class="form-row">
        <label>Safe page (default)</label>
        <select name="safe_page_id">
          <option value="">– None –</option>
          <% pages.filter(p => p.kind === 'safe').forEach(p => { %>
            <option value="<%= p._id %>" <%= campaign?.safe_page_id?.toString() === p._id.toString() ? 'selected' : '' %>>
              <%= p.name %>
            </option>
          <% }) %>
        </select>
      </div>
    </div>
  </fieldset>

  <fieldset>
    <legend style="font-weight:600; padding:0 6px;">Per-Device Pages (optional)</legend>
    <p class="muted" style="margin-top:0;">
      Override the default Offer / Safe page per device class. Useful for app campaigns that
      want to deep-link to App Store on iPhone, Play Store on Android, etc. Leave any cell as
      "use default" to fall back to the campaign-wide default above.
    </p>

    <%
      const dp = campaign?.device_pages || {};
      const deviceClasses = [
        { key: 'iphone',  label: 'iPhone' },
        { key: 'android', label: 'Android' },
        { key: 'windows', label: 'Windows' },
        { key: 'mac',     label: 'Mac' },
        { key: 'linux',   label: 'Linux' },
        { key: 'other',   label: 'Other (iPad, TV, unknown)' },
      ];
      const offerPages = pages.filter(p => p.kind !== 'safe');
      const safePages  = pages.filter(p => p.kind === 'safe');
    %>

    <table class="table table-dense" style="margin-top:8px;">
      <thead>
        <tr>
          <th>Device class</th>
          <th>Offer page</th>
          <th>Safe page</th>
        </tr>
      </thead>
      <tbody>
        <% deviceClasses.forEach(d => { %>
          <tr>
            <td><strong><%= d.label %></strong></td>
            <td>
              <select name="device_pages[<%= d.key %>][offer]" style="width:100%;">
                <option value="">— use default —</option>
                <% offerPages.forEach(p => { %>
                  <option value="<%= p._id %>" <%= dp[d.key]?.offer?.toString() === p._id.toString() ? 'selected' : '' %>>
                    <%= p.name %>
                  </option>
                <% }) %>
              </select>
            </td>
            <td>
              <select name="device_pages[<%= d.key %>][safe]" style="width:100%;">
                <option value="">— use default —</option>
                <% safePages.forEach(p => { %>
                  <option value="<%= p._id %>" <%= dp[d.key]?.safe?.toString() === p._id.toString() ? 'selected' : '' %>>
                    <%= p.name %>
                  </option>
                <% }) %>
              </select>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </fieldset>

  <%
    // ── Country Rules (advanced) ──────────────────────────────────────────
    var crEnabled = !!(campaign && campaign.country_rules_enabled);
    var crRules = (campaign && campaign.country_rules) ? JSON.parse(JSON.stringify(campaign.country_rules)) : [];
    var crCountries = (typeof countryList !== 'undefined' && countryList) ? countryList : [];
    var crPages = pages.map(function (p) { return { id: String(p._id), name: p.name, kind: p.kind === 'safe' ? 'safe' : 'offer' }; });
    var crData = JSON.stringify({ rules: crRules, pages: crPages, countries: crCountries }).replace(/</g, '\\u003c');
    var crInitialType = (campaign && campaign.campaign_type) ? campaign.campaign_type : (typeof presetType !== 'undefined' ? presetType : 'offer');
  %>
  <fieldset id="countryRulesFieldset" class="cr-type-<%= crInitialType === 'redirect' ? 'redirect' : 'offer' %>">
    <legend style="font-weight:600; padding:0 6px;">🌍 Country Rules <span class="muted" style="font-weight:400;">(advanced, optional)</span></legend>
    <style>
      #countryRulesFieldset .cr-add { display:flex; gap:8px; align-items:center; flex-wrap:wrap; margin:10px 0 14px; }
      #countryRulesFieldset .cr-add input { flex:1; min-width:240px; }
      #countryRulesFieldset .cr-card { border:1px solid var(--border-default, #2a3441); border-radius:var(--radius-md, 8px); margin-bottom:12px; overflow:hidden; }
      #countryRulesFieldset .cr-card.cr-off { opacity:.55; }
      #countryRulesFieldset .cr-head { display:flex; align-items:center; gap:10px; padding:10px 12px; background:rgba(255,255,255,.03); flex-wrap:wrap; }
      #countryRulesFieldset .cr-head .cr-flag { font-size:20px; line-height:1; }
      #countryRulesFieldset .cr-head .cr-spacer { flex:1; }
      #countryRulesFieldset .cr-head label { display:flex; align-items:center; gap:6px; font-weight:400; margin:0; }
      #countryRulesFieldset .cr-head input[type=checkbox] { width:auto; margin:0; }
      #countryRulesFieldset .cr-card table { margin:0; }
      #countryRulesFieldset .cr-card.cr-collapsed table { display:none; }
      #countryRulesFieldset .cr-card select, #countryRulesFieldset .cr-card input[type=text] { width:100%; }
      #countryRulesFieldset .cr-row-default td { background:rgba(59,130,246,.06); }
      #countryRulesFieldset.cr-type-redirect .cr-col-offer { display:none; }
      #countryRulesFieldset.cr-type-offer .cr-col-redirect { display:none; }
      #countryRulesFieldset .cr-msg { font-size:12px; }
      #countryRulesFieldset .cr-msg.cr-err { color:#f87171; }
    </style>

    <p class="muted" style="margin-top:0;">
      Give visitors from specific countries their own pages per device class — and, on redirect campaigns,
      their own redirect URLs. For a visitor from a listed country the order is:
      <strong>country + device</strong> → <strong>country "All devices"</strong> → Per-Device Pages above → Default Pages.
      Countries that aren't listed, unknown countries, or rules switched off always use the campaign settings above.
      The visitor's country comes from IP enrichment (ProxyCheck / IPLocate), falling back to Cloudflare.
    </p>

    <div class="form-row">
      <label style="font-weight:normal; display:flex; align-items:center; gap:8px;">
        <input type="checkbox" name="country_rules_enabled" id="crEnabled" <%= crEnabled ? 'checked' : '' %> style="width:auto;">
        Enable country rules for this campaign
      </label>
    </div>

    <input type="hidden" name="country_rules_present" value="1">
    <%# Pre-filled with the stored rules so a save without JS round-trips them unchanged. %>
    <input type="hidden" name="country_rules_json" id="crJson" value="<%= JSON.stringify(crRules) %>">

    <div id="crBody" style="display:<%= crEnabled ? 'block' : 'none' %>;">
      <div class="cr-add">
        <input type="text" id="crAddInput" list="crCountryOptions" autocomplete="off"
               placeholder="Type a country name or ISO code — e.g. Germany or DE">
        <button type="button" class="btn btn-small" id="crAddBtn">+ Add country</button>
        <span class="cr-msg muted" id="crAddMsg"></span>
      </div>
      <datalist id="crCountryOptions">
        <% crCountries.forEach(function (c) { %><option value="<%= c.code %> — <%= c.name %>"></option><% }); %>
      </datalist>
      <div id="crList"></div>
      <p class="muted" id="crEmpty" style="margin:4px 0 0;">No countries added yet. Add one above to give it its own pages.</p>
    </div>

    <script type="application/json" id="crData"><%- crData %></script>
    <script>
    (function () {
      var fs = document.getElementById('countryRulesFieldset');
      if (!fs) return;
      var data = {};
      try { data = JSON.parse(document.getElementById('crData').textContent || '{}'); } catch (e) { return; }
      var pages = data.pages || [];
      var countries = data.countries || [];
      var byCode = {};
      countries.forEach(function (c) { byCode[c.code] = c; });
      var SLOTS = [
        ['default', 'All devices <span class="muted" style="font-weight:400;">(country default)</span>'],
        ['iphone', 'iPhone'], ['android', 'Android'], ['windows', 'Windows'],
        ['mac', 'Mac'], ['linux', 'Linux'], ['other', 'Other (iPad, TV, unknown)'],
      ];
      var list = document.getElementById('crList');
      var empty = document.getElementById('crEmpty');
      var msg = document.getElementById('crAddMsg');
      var input = document.getElementById('crAddInput');

      function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
      function flag(code) {
        if (!/^[A-Z]{2}$/.test(code)) return '🏳️';
        return String.fromCodePoint(0x1F1E6 + code.charCodeAt(0) - 65, 0x1F1E6 + code.charCodeAt(1) - 65);
      }
      function pageOptions(kind, selected, isDefaultRow) {
        var html = '<option value="">' + (isDefaultRow ? '— use campaign setting —' : '— use default —') + '</option>';
        pages.filter(function (p) { return p.kind === kind; }).forEach(function (p) {
          html += '<option value="' + esc(p.id) + '"' + (p.id === selected ? ' selected' : '') + '>' + esc(p.name) + '</option>';
        });
        return html;
      }
      function setMsg(text, isErr) {
        msg.textContent = text || '';
        msg.className = 'cr-msg ' + (isErr ? 'cr-err' : 'muted');
      }
      function refreshEmpty() { empty.style.display = list.children.length ? 'none' : 'block'; }

      function addCard(rule, opts) {
        var code = rule.country;
        var name = (byCode[code] && byCode[code].name) || code;
        var pg = rule.pages || {};
        var ru = rule.redirect_urls || {};
        var card = document.createElement('div');
        card.className = 'cr-card' + (rule.enabled === false ? ' cr-off' : '') + (opts && opts.collapsed ? ' cr-collapsed' : '');
        card.setAttribute('data-country', code);
        var rows = SLOTS.map(function (s) {
          var slot = s[0], isDef = slot === 'default', e = pg[slot] || {};
          return '<tr class="' + (isDef ? 'cr-row-default' : '') + '" data-slot="' + slot + '">' +
            '<td><strong>' + s[1] + '</strong></td>' +
            '<td class="cr-col-offer"><select class="cr-offer">' + pageOptions('offer', e.offer || '', isDef) + '</select></td>' +
            '<td><select class="cr-safe">' + pageOptions('safe', e.safe || '', isDef) + '</select></td>' +
            '<td class="cr-col-redirect"><input type="text" class="cr-url" value="' + esc(ru[slot] || '') + '" placeholder="' +
              (isDef ? 'https://… (blank = campaign setting)' : '(use default)') + '"></td>' +
          '</tr>';
        }).join('');
        card.innerHTML =
          '<div class="cr-head">' +
            '<span class="cr-flag">' + flag(code) + '</span>' +
            '<strong>' + esc(name) + '</strong> <code>' + esc(code) + '</code>' +
            '<span class="cr-spacer"></span>' +
            '<label><input type="checkbox" class="cr-on"' + (rule.enabled === false ? '' : ' checked') + '> Active</label>' +
            '<button type="button" class="btn btn-small cr-toggle">' + (opts && opts.collapsed ? 'Expand' : 'Collapse') + '</button>' +
            '<button type="button" class="btn btn-small cr-remove" style="color:#f87171;">Remove</button>' +
          '</div>' +
          '<table class="table table-dense"><thead><tr>' +
            '<th style="width:190px;">Device class</th>' +
            '<th class="cr-col-offer">Offer page</th><th>Safe page</th>' +
            '<th class="cr-col-redirect">Redirect URL</th>' +
          '</tr></thead><tbody>' + rows + '</tbody></table>';
        card.querySelector('.cr-on').addEventListener('change', function () { card.classList.toggle('cr-off', !this.checked); });
        card.querySelector('.cr-toggle').addEventListener('click', function () {
          var c = card.classList.toggle('cr-collapsed');
          this.textContent = c ? 'Expand' : 'Collapse';
        });
        card.querySelector('.cr-remove').addEventListener('click', function () {
          if (!confirm('Remove the rule for ' + name + ' (' + code + ')?')) return;
          card.remove(); refreshEmpty();
        });
        list.appendChild(card);
        refreshEmpty();
        return card;
      }

      // Accepts "DE", "de", "DE — Germany", "Germany", or a unique name prefix.
      function resolveCountry(raw) {
        var v = String(raw || '').trim();
        if (!v) return null;
        var m = v.match(/^([A-Za-z]{2})(?:\s|—|-|$)/);
        if (m && byCode[m[1].toUpperCase()]) return m[1].toUpperCase();
        var lower = v.toLowerCase();
        var exact = countries.filter(function (c) { return c.name.toLowerCase() === lower; });
        if (exact.length === 1) return exact[0].code;
        var pre = countries.filter(function (c) { return c.name.toLowerCase().indexOf(lower) === 0; });
        if (pre.length === 1) return pre[0].code;
        return null;
      }

      function doAdd() {
        var code = resolveCountry(input.value);
        if (!code) { setMsg('Unknown country — pick one from the list or type a 2-letter ISO code.', true); return; }
        var existing = list.querySelector('[data-country="' + code + '"]');
        if (existing) {
          setMsg((byCode[code] ? byCode[code].name : code) + ' is already added.', true);
          existing.classList.remove('cr-collapsed');
          existing.scrollIntoView({ behavior: 'smooth', block: 'center' });
          return;
        }
        addCard({ country: code, enabled: true, pages: {}, redirect_urls: {} });
        input.value = '';
        setMsg('Added ' + (byCode[code] ? byCode[code].name : code) + '.', false);
      }
      document.getElementById('crAddBtn').addEventListener('click', doAdd);
      input.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); doAdd(); } });

      document.getElementById('crEnabled').addEventListener('change', function () {
        document.getElementById('crBody').style.display = this.checked ? 'block' : 'none';
      });
      var typeSel = document.getElementById('campaignType');
      if (typeSel) typeSel.addEventListener('change', function () {
        fs.classList.toggle('cr-type-redirect', this.value === 'redirect');
        fs.classList.toggle('cr-type-offer', this.value !== 'redirect');
      });

      function serialize() {
        var out = [];
        list.querySelectorAll('.cr-card').forEach(function (card) {
          var rule = { country: card.getAttribute('data-country'), enabled: card.querySelector('.cr-on').checked, pages: {}, redirect_urls: {} };
          card.querySelectorAll('tbody tr').forEach(function (tr) {
            var slot = tr.getAttribute('data-slot');
            var offer = tr.querySelector('.cr-offer').value;
            var safe = tr.querySelector('.cr-safe').value;
            if (offer || safe) { rule.pages[slot] = {}; if (offer) rule.pages[slot].offer = offer; if (safe) rule.pages[slot].safe = safe; }
            rule.redirect_urls[slot] = tr.querySelector('.cr-url').value.trim();
          });
          out.push(rule);
        });
        document.getElementById('crJson').value = JSON.stringify(out);
      }
      var form = fs.closest('form');
      if (form) form.addEventListener('submit', serialize);

      // Existing rules start collapsed when there are several, to keep the form short.
      var initial = data.rules || [];
      initial.forEach(function (r) { if (r && r.country) addCard(r, { collapsed: initial.length > 2 }); });
      refreshEmpty();
    })();
    </script>
  </fieldset>

  <div class="form-row">
    <label>Filter Threshold (0–100)</label>
    <input type="number" name="threshold" min="0" max="100" value="<%= campaign?.filter_config?.threshold ?? 70 %>">
    <small class="muted">Block when total bot score reaches this value. Higher = more permissive.</small>
  </div>

  <div class="form-row">
    <label>Mode</label>
    <select name="mode">
      <option value="log_only" <%= campaign?.filter_config?.mode === 'log_only' ? 'selected' : '' %>>log_only — log decisions but always render offer</option>
      <option value="enforce" <%= campaign?.filter_config?.mode === 'enforce' ? 'selected' : '' %>>enforce — actually block bad traffic</option>
    </select>
  </div>

  <fieldset>
    <legend style="font-weight:600; padding:0 6px;">UTM Gate</legend>
    <p class="muted" style="margin-top:0;">
      When enabled, visits missing required UTM keys are routed to the safe page. Useful to keep
      direct visits, scrapers, and stripped social shares off the offer page.
    </p>

    <div class="form-row">
      <label style="font-weight:normal;">
        <input type="checkbox" name="utm_gate_enabled"
          <%= campaign?.filter_config?.utm_gate?.enabled ? 'checked' : '' %>>
        Enable UTM gate
      </label>
    </div>

    <div class="form-row">
      <label>Mode</label>
      <%
        const utmMode = campaign?.filter_config?.utm_gate?.mode === 'monitor' ? 'monitor' : 'enforce';
      %>
      <div style="display:flex; gap:18px; flex-wrap:wrap;">
        <label style="font-weight:normal;">
          <input type="radio" name="utm_gate_mode" value="enforce" <%= utmMode === 'enforce' ? 'checked' : '' %>>
          Enforce — block visits missing required keys (route to safe page)
        </label>
        <label style="font-weight:normal;">
          <input type="radio" name="utm_gate_mode" value="monitor" <%= utmMode === 'monitor' ? 'checked' : '' %>>
          Monitor — flag missing keys in the Click Log, but still show the offer
        </label>
      </div>
      <small class="muted">Use Monitor to verify your Final URL is passing UTMs (watch the Click Log for <code>utm_gate_monitor_would_block</code> / <code>utm_missing_*</code>), then switch to Enforce once traffic is clean.</small>
    </div>

    <div class="form-row">
      <label>Required UTM keys</label>
      <%
        const requiredKeys = campaign?.filter_config?.utm_gate?.required_keys || ['source','medium','campaign'];
      %>
      <div style="display:flex; gap:14px; flex-wrap:wrap;">
        <% ['source', 'medium', 'campaign', 'term', 'content'].forEach(k => { %>
          <label style="font-weight:normal;">
            <input type="checkbox" name="utm_required_keys" value="<%= k %>"
              <%= requiredKeys.includes(k) ? 'checked' : '' %>>
            utm_<%= k %>
          </label>
        <% }) %>
      </div>
      <small class="muted">A visit must have ALL the checked keys present (and non-empty) to reach the offer.</small>
    </div>
  </fieldset>

  <fieldset>
    <legend style="font-weight:600; padding:0 6px;">Click Identifier Gate</legend>
    <p class="muted" style="margin-top:0;">
      Every real ad click carries a click identifier that the ad network auto-appends
      (Google: gclid/wbraid/gbraid, Bing: msclkid). When enabled, visits with valid UTMs
      but no click ID are routed to the safe page — catching copy/paste, scrapers, and URL replay bots.
    </p>

    <div class="form-row">
      <label style="font-weight:normal;">
        <input type="checkbox" name="clickid_gate_enabled"
          <%= campaign?.filter_config?.clickid_gate?.enabled ? 'checked' : '' %>>
        Enable Click ID gate
      </label>
    </div>

    <div class="form-row">
      <label>Accepted click identifiers</label>
      <%
        const acceptedIds = campaign?.filter_config?.clickid_gate?.accepted_ids || ['gclid','wbraid','gbraid'];
        const idGroups = {
          'Google Ads': [['gclid','gclid (standard)'], ['wbraid','wbraid (iOS app→web)'], ['gbraid','gbraid (iOS web→app)']],
          'Other platforms': [['msclkid','msclkid (Bing)'], ['fbclid','fbclid (Facebook/IG)'], ['ttclid','ttclid (TikTok)'], ['li_fat_id','li_fat_id (LinkedIn)'], ['twclid','twclid (Twitter/X)'], ['rdt_cid','rdt_cid (Reddit)']],
        };
      %>
      <% Object.entries(idGroups).forEach(([groupName, ids]) => { %>
        <div style="margin-bottom:10px;">
          <div class="muted" style="font-size:12px; font-weight:600; margin-bottom:4px;"><%= groupName %></div>
          <div style="display:flex; gap:14px; flex-wrap:wrap;">
            <% ids.forEach(([id, label]) => { %>
              <label style="font-weight:normal;">
                <input type="checkbox" name="clickid_accepted_ids" value="<%= id %>"
                  <%= acceptedIds.includes(id) ? 'checked' : '' %>>
                <%= label %>
              </label>
            <% }) %>
          </div>
        </div>
      <% }) %>
      <small class="muted">A visit needs AT LEAST ONE of the checked identifiers to reach the offer. Match these to the platform you're running: Google IDs for Google Ads, fbclid for Facebook, twclid for Twitter/X, rdt_cid for Reddit, etc.</small>
    </div>

    <div class="form-row">
      <label>Format validation</label>
      <% const vf = campaign?.filter_config?.clickid_gate?.validate_format || 'off'; %>
      <select name="clickid_validate_format" style="max-width:280px;">
        <option value="off"    <%= vf === 'off'    ? 'selected' : '' %>>Off — presence only</option>
        <option value="loose"  <%= vf === 'loose'  ? 'selected' : '' %>>Loose — length + charset checks</option>
        <option value="strict" <%= vf === 'strict' ? 'selected' : '' %>>Strict — platform patterns + entropy</option>
      </select>
      <small class="muted">
        Checks the click ID looks real, catching lazy fakes like <code>gclid=test</code> or <code>gclid=12345</code>.
        <strong>Loose</strong> is safe for all traffic. <strong>Strict</strong> adds platform-specific pattern
        and entropy checks (slightly higher false-positive risk). Note: only the ad platform can confirm a click ID is
        genuinely theirs — this catches obvious fakes, not sophisticated ones.
      </small>
    </div>
  </fieldset>

  <fieldset>
    <legend style="font-weight:600; padding:0 6px;">Country Gate</legend>
    <p class="muted" style="margin-top:0;">
      Cross-checks ProxyCheck's country verdict against your list. Whitelist mode = only listed
      countries pass. Blacklist mode = listed countries blocked.
      Requires <code>PROXYCHECK_API_KEY</code> to be set; otherwise <code>on_unknown</code> decides.
    </p>

    <%
      const cg = campaign?.filter_config?.country_gate || {};
      const cgList = Array.isArray(cg.countries) ? cg.countries.join(', ') : '';
    %>

    <div class="form-row">
      <label style="font-weight:normal;">
        <input type="checkbox" name="country_gate_enabled" <%= cg.enabled ? 'checked' : '' %>>
        Enable country gate
      </label>
    </div>

    <div class="grid-2">
      <div class="form-row">
        <label>Mode</label>
        <select name="country_gate_mode">
          <option value="whitelist" <%= cg.mode !== 'blacklist' ? 'selected' : '' %>>
            whitelist — only listed countries pass
          </option>
          <option value="blacklist" <%= cg.mode === 'blacklist' ? 'selected' : '' %>>
            blacklist — listed countries blocked
          </option>
        </select>
      </div>
      <div class="form-row">
        <label>If country unknown</label>
        <select name="country_gate_on_unknown">
          <option value="allow" <%= cg.on_unknown !== 'block' ? 'selected' : '' %>>
            allow (permissive — pass through)
          </option>
          <option value="block" <%= cg.on_unknown === 'block' ? 'selected' : '' %>>
            block (strict — show safe page)
          </option>
        </select>
      </div>
    </div>

    <div class="form-row">
      <label>Country list (ISO 3166-1 alpha-2 codes, comma-separated)</label>
      <textarea name="country_list" rows="3" placeholder="US, CA, GB, AU, DE, FR"><%= cgList %></textarea>
      <small class="muted">
        Two-letter codes only. Common: US (United States), GB (United Kingdom), CA (Canada),
        AU (Australia), DE (Germany), FR (France), IN (India). Case insensitive; invalid entries are dropped.
      </small>
    </div>
  </fieldset>

  <fieldset>
    <legend style="font-weight:600; padding:0 6px;">Proxy Gate</legend>
    <p class="muted" style="margin-top:0;">
      Hard route to safe page on proxy/VPN/Tor detection. Reads ProxyCheck verdict +
      ASN/term blacklist. Tighter than score-based filtering — when this fires the visit
      is blocked regardless of other layers.
    </p>

    <%
      const pg = campaign?.filter_config?.proxy_gate || {};
      // Defaults align with model defaults: VPN/Tor/public/compromised ON, hosting OFF
      const defaultBool = (v, def) => v === undefined ? def : !!v;
    %>

    <div class="form-row">
      <label style="font-weight:normal;">
        <input type="checkbox" name="proxy_gate_enabled" <%= pg.enabled ? 'checked' : '' %>>
        Enable proxy gate
      </label>
    </div>

    <div class="form-row">
      <label>Block on detection of:</label>
      <div style="display:flex; gap:14px; flex-wrap:wrap;">
        <label style="font-weight:normal;">
          <input type="checkbox" name="proxy_block_vpn" <%= defaultBool(pg.block_vpn, true) ? 'checked' : '' %>>
          VPN
        </label>
        <label style="font-weight:normal;">
          <input type="checkbox" name="proxy_block_tor" <%= defaultBool(pg.block_tor, true) ? 'checked' : '' %>>
          Tor
        </label>
        <label style="font-weight:normal;">
          <input type="checkbox" name="proxy_block_public_proxy" <%= defaultBool(pg.block_public_proxy, true) ? 'checked' : '' %>>
          Public proxy
        </label>
        <label style="font-weight:normal;">
          <input type="checkbox" name="proxy_block_compromised" <%= defaultBool(pg.block_compromised, true) ? 'checked' : '' %>>
          Compromised
        </label>
        <label style="font-weight:normal;">
          <input type="checkbox" name="proxy_block_hosting" <%= defaultBool(pg.block_hosting, false) ? 'checked' : '' %>>
          Datacenter / hosting
        </label>
      </div>
      <small class="muted">
        "Datacenter" is off by default because corporate VPNs land in those ranges and you'll false-positive real users.
      </small>
    </div>

    <div class="form-row">
      <label>Max risk score (ProxyCheck's own 0–100 score)</label>
      <input type="number" name="proxy_max_risk_score" min="0" max="100" value="<%= pg.max_risk_score ?? 100 %>">
      <small class="muted">Block when ProxyCheck's risk score exceeds this. 100 = disabled.</small>
    </div>
  </fieldset>

  <fieldset>
    <legend style="font-weight:600; padding:0 6px;">Bot Guard (Level 2)</legend>
    <p class="muted" style="margin-top:0;">
      Serves a client-side interstitial that checks browser timezone vs the IP's
      timezone, dwell time, interaction, and (optionally) WebGL before the offer
      is shown. Choose which device classes are challenged — the rest skip
      Level 2 and go straight through.
    </p>

    <%
      const bg = campaign?.filter_config?.bot_guard || {};
      const bgBool = (v, def) => v === undefined ? def : !!v;
      const bgDevices = Array.isArray(bg.devices) ? bg.devices : ['iphone','android','windows','mac','linux','other'];
      const deviceList = [
        { key: 'iphone',  label: 'iPhone' },
        { key: 'android', label: 'Android' },
        { key: 'windows', label: 'Windows' },
        { key: 'mac',     label: 'Mac' },
        { key: 'linux',   label: 'Linux' },
        { key: 'other',   label: 'Other' },
      ];
    %>

    <div class="form-row">
      <label style="font-weight:normal;">
        <input type="checkbox" name="bot_guard_enabled" <%= bg.enabled ? 'checked' : '' %>>
        Enable Bot Guard for this campaign
      </label>
    </div>

    <div class="form-row">
      <label>Challenge these devices:</label>
      <div style="display:flex; gap:14px; flex-wrap:wrap;">
        <% deviceList.forEach(function(d) { %>
          <label style="font-weight:normal;">
            <input type="checkbox" name="bot_guard_devices" value="<%= d.key %>"
              <%= bgDevices.includes(d.key) ? 'checked' : '' %>>
            <%= d.label %>
          </label>
        <% }); %>
      </div>
      <small class="muted">Device classes not ticked here bypass Level 2 entirely. If none are ticked while the guard is enabled, all devices are challenged.</small>
    </div>

    <div class="form-row">
      <label>Checks to run:</label>
      <div style="display:flex; gap:14px; flex-wrap:wrap;">
        <label style="font-weight:normal;">
          <input type="checkbox" name="bot_guard_timezone" <%= bgBool(bg.check_timezone, true) ? 'checked' : '' %>>
          Timezone (IP vs browser)
        </label>
        <label style="font-weight:normal;">
          <input type="checkbox" name="bot_guard_interaction" <%= bgBool(bg.check_interaction, true) ? 'checked' : '' %>>
          Interaction
        </label>
        <label style="font-weight:normal;">
          <input type="checkbox" name="bot_guard_dwell" <%= bgBool(bg.check_dwell, true) ? 'checked' : '' %>>
          Dwell time
        </label>
        <label style="font-weight:normal;">
          <input type="checkbox" name="bot_guard_webgl" <%= bgBool(bg.check_webgl, false) ? 'checked' : '' %>>
          WebGL / canvas
        </label>
      </div>
    </div>

    <div class="form-row">
      <label>Minimum dwell (ms)</label>
      <input type="number" name="bot_guard_min_dwell" min="1000" max="10000" value="<%= bg.min_dwell_ms ?? 2000 %>">
      <small class="muted">Time the visitor must stay on the interstitial. Clamped 1000–10000 ms.</small>
    </div>
  </fieldset>

  <div class="form-row">
    <label>S2S Postback URL <span class="muted">(optional)</span></label>
    <input type="text" name="postback_url" value="<%= campaign?.postback_url || '' %>" placeholder="https://your-tracker.example.com/postback?clickid={click_id}">
  </div>

  <%# ── Ad Schedule ─────────────────────────────────────────────────────── %>
  <fieldset>
    <legend style="font-weight:600; padding:0 6px;">Ad Schedule</legend>
    <%
      var sched = (campaign && campaign.ad_schedule) || { enabled: false, timezone: 'UTC', rules: [] };
      var schedEnabled = !!sched.enabled;
      var schedTz = sched.timezone || 'UTC';
      var schedRules = Array.isArray(sched.rules) ? sched.rules : [];
      var dayNames = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
    %>

    <div class="form-row">
      <label><input type="checkbox" name="sched_enabled" value="1" <%= schedEnabled ? 'checked' : '' %> onchange="document.getElementById('schedFields').style.display=this.checked?'block':'none';"> Enable ad schedule</label>
      <small class="muted">When enabled, the campaign only serves traffic during the windows below. Outside those windows it behaves as paused (safe page). Manual pause/unpause overrides the schedule. Off by default = campaign runs 24/7.</small>
    </div>

    <div id="schedFields" style="display:<%= schedEnabled ? 'block' : 'none' %>;">
      <div class="form-row">
        <label>Schedule timezone</label>
        <input type="text" name="sched_timezone" value="<%= schedTz %>" placeholder="e.g. America/New_York, Asia/Kolkata, UTC" style="max-width:320px;">
        <small class="muted">IANA timezone name. The UI shows your browser's local time — enter the timezone your schedule is in. <a href="https://en.wikipedia.org/wiki/List_of_tz_database_time_zones" target="_blank">List</a></small>
      </div>

      <div class="form-row">
        <label>Run windows (times in the timezone above)</label>
        <small class="muted" style="display:block; margin-bottom:8px;">Add one or more windows. The campaign runs during ANY matching window. For cross-midnight (e.g. 20:30 to 02:00), add two rules: one for 20:30–00:00 and another for 00:00–02:00 (same as Google Ads).</small>
        <div id="schedRulesContainer">
          <% if (schedRules.length === 0) schedRules = [{day:1, start:'00:00', end:'23:59'}]; %>
          <% schedRules.forEach(function(r, i){ %>
            <div class="sched-rule" style="display:flex; gap:8px; align-items:center; margin-bottom:6px;">
              <select name="sched_day">
                <% dayNames.forEach(function(dn, di){ %>
                  <option value="<%= di %>" <%= r.day === di ? 'selected' : '' %>><%= dn %></option>
                <% }); %>
              </select>
              <input type="time" name="sched_start" value="<%= r.start || '00:00' %>" style="width:110px;">
              <span>to</span>
              <input type="time" name="sched_end" value="<%= r.end || '23:59' %>" style="width:110px;">
              <button type="button" class="btn btn-small" onclick="this.parentNode.remove();" style="color:#f87171;">×</button>
            </div>
          <% }); %>
        </div>
        <button type="button" class="btn btn-small" onclick="addSchedRule()">+ Add window</button>
      </div>
    </div>

    <script>
    // Auto-detect the browser's timezone and prefill if the field is empty or 'UTC'.
    (function() {
      var tzField = document.querySelector('input[name="sched_timezone"]');
      if (tzField && (!tzField.value || tzField.value === 'UTC')) {
        try { tzField.value = Intl.DateTimeFormat().resolvedOptions().timeZone; } catch(e) {}
      }
    })();

    function addSchedRule() {
      var c = document.getElementById('schedRulesContainer');
      var div = document.createElement('div');
      div.className = 'sched-rule';
      div.style.cssText = 'display:flex;gap:8px;align-items:center;margin-bottom:6px;';
      var days = <%- JSON.stringify(dayNames) %>;
      var opts = days.map(function(d,i){return '<option value="'+i+'">'+d+'</option>';}).join('');
      div.innerHTML = '<select name="sched_day">'+opts+'</select>'
        + '<input type="time" name="sched_start" value="00:00" style="width:110px;">'
        + '<span>to</span>'
        + '<input type="time" name="sched_end" value="23:59" style="width:110px;">'
        + '<button type="button" class="btn btn-small" onclick="this.parentNode.remove();" style="color:#f87171;">×</button>';
      c.appendChild(div);
    }
    </script>
  </fieldset>

  <div class="form-row">
    <label>Notes</label>
    <textarea name="notes" rows="3"><%= campaign?.notes || '' %></textarea>
  </div>

  <div class="form-actions">
    <button type="submit" class="btn btn-primary"><%= campaign ? 'Save changes' : 'Create campaign' %></button>
    <a href="/admin/campaigns" class="btn">Cancel</a>
  </div>
</form>

<% if (campaign && campaign._id) { %>
<%
  // Build the tracking URLs for this campaign
  const base = (typeof baseUrl !== 'undefined' && baseUrl) ? baseUrl.replace(/\/$/, '') : '';
  const landingUrl = campaign.root_path
    ? `${base}/${campaign.root_path}`
    : `${base}/go/${campaign.slug}`;

  // The Final URL suffix — the full parameter string to paste into Google Ads.
  // Uses the compact tracking template with ValueTrack macros.
  const finalUrlSuffix = [
    'utm_source=google',
    'utm_medium=display_ads',
    `utm_campaign=${campaign.slug}`,
    'utm_content={placement}',
    'tm=tt',
    'ap=gads',
    'cid={campaignid}',
    'agid={adgroupid}',
    'aid={creative}',
    'kid={targetid}',
    'kw={keyword}',
    'nw={network}',
    'dv={device}',
    'mt={matchtype}',
    'pl={placement}',
  ].join('&');
%>
<section class="panel" style="margin-top:24px; border:1px solid var(--color-primary, #3b82f6);">
  <h3>📋 Google Ads Setup</h3>
  <p class="muted" style="margin-bottom:16px;">
    Copy these into your Google Ads campaign's <strong>Campaign URL options</strong>.
  </p>

  <div class="form-row">
    <label>Final URL <span class="muted">(the landing page URL for your ad)</span></label>
    <div style="display:flex; gap:8px; align-items:center;">
      <input type="text" id="final_url" readonly value="<%= landingUrl %>"
        style="flex:1; font-family:var(--font-mono); font-size:13px;" onclick="this.select()">
      <button type="button" class="btn btn-small" onclick="copyField('final_url', this)">Copy</button>
    </div>
  </div>

  <div class="form-row" style="margin-top:16px;">
    <label>Final URL suffix <span class="muted">(paste into "Final URL suffix" field)</span></label>
    <div style="display:flex; gap:8px; align-items:flex-start;">
      <textarea id="url_suffix" readonly rows="3"
        style="flex:1; font-family:var(--font-mono); font-size:12px; resize:vertical;"
        onclick="this.select()"><%= finalUrlSuffix %></textarea>
      <button type="button" class="btn btn-small" onclick="copyField('url_suffix', this)">Copy</button>
    </div>
    <small class="muted" style="margin-top:6px; display:block;">
      This captures campaign ID, ad group, creative, keyword, network, device, match type, and placement —
      all visible per-click in the ValueTrack panel. Google fills the <code>{...}</code> macros automatically.
    </small>
  </div>

  <details style="margin-top:12px;">
    <summary style="cursor:pointer; font-weight:600; font-size:13px;">Setup steps</summary>
    <div style="margin-top:10px; padding:12px 16px; background:var(--bg-code, #1a1a2e); border-radius:8px; font-size:13px; line-height:1.9;">
      <strong>1.</strong> In Google Ads, open your campaign → Settings → <strong>Campaign URL options</strong><br>
      <strong>2.</strong> Set your ad's <strong>Final URL</strong> to the landing URL above<br>
      <strong>3.</strong> Paste the suffix into <strong>Final URL suffix</strong><br>
      <strong>4.</strong> Click <strong>Test</strong> to verify, then Save<br>
      <strong>5.</strong> For app campaigns, the <code>{placement}</code> in utm_content becomes <code>mobileapp::1-{app_id}</code> automatically
    </div>
  </details>
</section>

<script>
function copyField(id, btn) {
  var el = document.getElementById(id);
  el.select();
  el.setSelectionRange(0, 99999);
  try {
    navigator.clipboard.writeText(el.value).then(function() {
      var orig = btn.textContent;
      btn.textContent = '✓ Copied';
      setTimeout(function(){ btn.textContent = orig; }, 1500);
    });
  } catch (e) {
    document.execCommand('copy');
    btn.textContent = '✓ Copied';
  }
}
</script>
<% } %>

<%- include('../partials/footer') %>
