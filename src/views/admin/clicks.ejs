<%- include('../partials/header', { ws, page, title: 'Click Log - BotGuard' }) %>
<%
  // Convert 2-letter ISO country code to emoji flag
  // "US" → 🇺🇸, "TR" → 🇹🇷, "PK" → 🇵🇰
  function countryFlag(code) {
    if (!code || code.length !== 2) return '';
    return String.fromCodePoint(
      ...code.toUpperCase().split('').map(c => 0x1F1E6 + c.charCodeAt(0) - 65)
    );
  }
%>

<div class="page-header">
  <div>
    <h1>Click Log</h1>
    <p class="muted">
      <% if (totalCount === 0) { %>
        No clicks in <strong><%= range.label %></strong>.
      <% } else { %>
        Showing <strong><%= showingFrom.toLocaleString() %>–<%= showingTo.toLocaleString() %></strong>
        of <strong><%= totalCount.toLocaleString() %></strong> clicks
        · <strong><%= range.label %></strong>.
        Use filters to narrow down.
      <% } %>
    </p>
  </div>
  <div>
    <a href="/admin/clicks.csv?<%= new URLSearchParams(query).toString() %>" class="btn" title="Download up to 10,000 rows matching the current filters">Export CSV</a>
  </div>
</div>

<form method="GET" class="filter-bar">
  <div style="display:flex; gap:10px; flex-wrap:wrap; align-items:flex-end;">
    <select name="range" onchange="document.getElementById('custom-dates').style.display = this.value === 'custom' ? '' : 'none';">
      <% rangeOptions.forEach(opt => { %>
        <option value="<%= opt.value %>" <%= range.range === opt.value ? 'selected' : '' %>><%= opt.label %></option>
      <% }) %>
    </select>

    <span id="custom-dates" style="<%= range.range === 'custom' ? '' : 'display:none' %>; display:inline-flex; gap:6px; align-items:center;">
      <input type="date" name="date_from" value="<%= query.date_from || '' %>">
      <input type="date" name="date_to" value="<%= query.date_to || '' %>">
    </span>

    <select name="campaign">
      <option value="">All campaigns</option>
      <% campaigns.forEach(c => { %>
        <option value="<%= c._id %>" <%= query.campaign === c._id.toString() ? 'selected' : '' %>><%= c.name %></option>
      <% }) %>
    </select>

    <select name="decision">
      <option value="">All decisions</option>
      <% ['allow', 'block', 'would_block'].forEach(d => { %>
        <option value="<%= d %>" <%= query.decision === d ? 'selected' : '' %>><%= d %></option>
      <% }) %>
    </select>

    <button type="submit" class="btn btn-primary">Filter</button>
    <a href="/admin/clicks" class="btn">Reset</a>
    <button type="button" class="btn btn-small" onclick="var p=document.getElementById('adv-filters');p.style.display=p.style.display==='none'?'block':'none';" style="margin-left:auto;">Advanced ▾</button>
  </div>

  <div id="adv-filters" style="display:<%= (query.source||query.medium||query.utm_campaign||query.utm_content||query.utm_term||query.click_id||query.vt_campaignid||query.vt_adgroupid||query.vt_creative||query.vt_keyword||query.vt_network||query.vt_device||query.vt_matchtype||query.vt_placement||query.vt_tm||query.vt_ap||query.country||query.ip||query.ip_type) ? 'block' : 'none' %>; margin-top:14px; border-top:1px solid var(--border-subtle); padding-top:14px;">
    <style>.adv-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:16px;}.adv-grid label{display:block;font-size:11px;color:var(--text-tertiary);margin-bottom:3px;}.adv-grid input,.adv-grid select{width:100%!important;box-sizing:border-box;font-size:13px;padding:7px 10px;}@media(max-width:900px){.adv-grid{grid-template-columns:repeat(2,1fr);}}@media(max-width:500px){.adv-grid{grid-template-columns:1fr;}}</style>

    <div style="font-size:12px;color:var(--text-secondary);margin-bottom:8px;font-weight:600;">UTM Parameters</div>
    <div class="adv-grid">
      <div><label>Source</label><input type="text" name="source" placeholder="e.g. google, hilltop" value="<%= query.source || '' %>"></div>
      <div><label>Medium</label><input type="text" name="medium" placeholder="e.g. cpc, display_ads" value="<%= query.medium || '' %>"></div>
      <div><label>Campaign</label><input type="text" name="utm_campaign" placeholder="e.g. classes" value="<%= query.utm_campaign || '' %>"></div>
      <div><label>Content</label><input type="text" name="utm_content" placeholder="e.g. placement" value="<%= query.utm_content || '' %>"></div>
      <div><label>Term</label><input type="text" name="utm_term" placeholder="e.g. cooking school" value="<%= query.utm_term || '' %>"></div>
    </div>

    <div style="font-size:12px;color:var(--text-secondary);margin-bottom:8px;font-weight:600;">ValueTrack (Google Ads)</div>
    <div class="adv-grid">
      <div><label>Campaign ID</label><input type="text" name="vt_campaignid" placeholder="e.g. 24040619516" value="<%= query.vt_campaignid || '' %>"></div>
      <div><label>Ad Group ID</label><input type="text" name="vt_adgroupid" placeholder="e.g. 201522912914" value="<%= query.vt_adgroupid || '' %>"></div>
      <div><label>Creative / Ad ID</label><input type="text" name="vt_creative" placeholder="e.g. 817167984708" value="<%= query.vt_creative || '' %>"></div>
      <div><label>Keyword</label><input type="text" name="vt_keyword" placeholder="e.g. cooking school" value="<%= query.vt_keyword || '' %>"></div>
      <div><label>Network</label>
        <select name="vt_network">
          <option value="">Any</option>
          <% [['g','Search'],['s','Search partner'],['d','Display'],['ytv','YouTube'],['x','Cross-network']].forEach(n => { %>
            <option value="<%= n[0] %>" <%= query.vt_network === n[0] ? 'selected' : '' %>><%= n[1] %> (<%= n[0] %>)</option>
          <% }) %>
        </select>
      </div>
      <div><label>Device</label>
        <select name="vt_device">
          <option value="">Any</option>
          <% [['m','Mobile'],['t','Tablet'],['c','Computer']].forEach(d => { %>
            <option value="<%= d[0] %>" <%= query.vt_device === d[0] ? 'selected' : '' %>><%= d[1] %> (<%= d[0] %>)</option>
          <% }) %>
        </select>
      </div>
      <div><label>Match type</label>
        <select name="vt_matchtype">
          <option value="">Any</option>
          <% [['e','Exact'],['p','Phrase'],['b','Broad']].forEach(m => { %>
            <option value="<%= m[0] %>" <%= query.vt_matchtype === m[0] ? 'selected' : '' %>><%= m[1] %> (<%= m[0] %>)</option>
          <% }) %>
        </select>
      </div>
      <div><label>Placement</label><input type="text" name="vt_placement" placeholder="e.g. mobileapp::1-…" value="<%= query.vt_placement || '' %>"></div>
    </div>

    <div style="font-size:12px;color:var(--text-secondary);margin-bottom:8px;font-weight:600;">Custom Tracking &amp; Click IDs</div>
    <div class="adv-grid">
      <div><label>Tracking Marker (tm)</label><input type="text" name="vt_tm" placeholder="e.g. tt" value="<%= query.vt_tm || '' %>"></div>
      <div><label>Ad Platform (ap)</label><input type="text" name="vt_ap" placeholder="e.g. gads" value="<%= query.vt_ap || '' %>"></div>
      <div><label>Click ID (gclid/fbclid/…)</label><input type="text" name="click_id" placeholder="Exact match" value="<%= query.click_id || '' %>"></div>
      <div><label>Country</label><input type="text" name="country" placeholder="e.g. US, IN" value="<%= query.country || '' %>"></div>
      <div><label>IP address</label><input type="text" name="ip" placeholder="Exact IP" value="<%= query.ip || '' %>"></div>
    </div>

    <% var selTypes = query.ip_type ? (Array.isArray(query.ip_type) ? query.ip_type : [query.ip_type]) : []; %>
    <div style="font-size:12px;color:var(--text-secondary);margin:4px 0 8px;font-weight:600;">Traffic type <span class="muted" style="font-weight:normal;">(select one or more)</span></div>
    <div class="tt-dd" style="position:relative;max-width:420px;margin-bottom:4px;">
      <button type="button" class="btn btn-small" style="width:100%;text-align:left;display:flex;justify-content:space-between;align-items:center;"
        onclick="var m=document.getElementById('tt-menu');m.style.display=m.style.display==='block'?'none':'block';">
        <span id="tt-label"><%= selTypes.length ? selTypes.length + ' selected' : 'Any traffic type' %></span>
        <span>▾</span>
      </button>
      <div id="tt-menu" style="display:none;position:absolute;z-index:20;top:100%;left:0;right:0;margin-top:4px;max-height:240px;overflow:auto;background:var(--bg-panel);border:1px solid var(--border-default);border-radius:var(--radius-md);padding:8px;box-shadow:var(--shadow-card);">
        <% if (!ipTypeOptions || !ipTypeOptions.length) { %>
          <div class="muted" style="font-size:12px;padding:4px;">No traffic types recorded yet.</div>
        <% } %>
        <% (ipTypeOptions || []).forEach(function(t){ %>
          <label style="display:flex;align-items:center;gap:8px;font-size:13px;padding:4px 6px;cursor:pointer;">
            <input type="checkbox" name="ip_type" value="<%= t %>" <%= selTypes.indexOf(t) !== -1 ? 'checked' : '' %>
              onchange="var n=document.querySelectorAll('#tt-menu input:checked').length;document.getElementById('tt-label').textContent=n?n+' selected':'Any traffic type';">
            <span><%= t %></span>
          </label>
        <% }); %>
      </div>
    </div>
  </div>
</form>

<%# ── Traffic analytics (respects the active filters) ───────────────────── %>
<% if (typeof stats !== 'undefined' && stats.grandTotal > 0) {
  var PALETTE = ['#f6821f','#3b82f6','#34d399','#a78bfa','#f87171','#fbbf24','#22d3ee','#f472b6','#84cc16','#94a3b8'];
  var pct = function(n, t){ return t ? (100*n/t) : 0; };
  var decColors = { allow:'#34d399', block:'#f87171', would_block:'#fbbf24', unknown:'#94a3b8' };
  var CIRC = 2 * Math.PI * 42;
%>
<style>
  .an-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:14px;margin-bottom:18px;}
  .an-grid-2{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-bottom:14px;}
  .an-stack{display:flex;flex-direction:column;gap:14px;}
  .an-grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:18px;}
  @media(max-width:900px){.an-grid-2{grid-template-columns:1fr;}.an-grid-3{grid-template-columns:1fr;}}
  .an-card{background:var(--bg-panel);border:1px solid var(--border-default);border-radius:var(--radius-md);padding:14px 16px;box-shadow:var(--shadow-card);}
  .an-title{font-size:12px;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:.04em;margin-bottom:12px;}
  .an-row{display:flex;align-items:center;gap:14px;}
  .an-legend{flex:1;min-width:0;font-size:12px;}
  .an-li{display:flex;align-items:center;gap:7px;margin-bottom:5px;}
  .an-dot{width:9px;height:9px;border-radius:2px;flex:none;}
  .an-lbl{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
  .an-val{font-variant-numeric:tabular-nums;color:var(--text-primary);font-weight:600;}
  .an-pct{color:var(--text-tertiary);font-size:11px;min-width:40px;text-align:right;display:inline-block;}
  .an-bar-track{height:7px;background:var(--bg-input);border-radius:4px;overflow:hidden;margin-top:3px;}
  .an-bar-fill{height:100%;border-radius:4px;}
  .an-ts{display:flex;align-items:stretch;gap:2px;height:120px;}
  .an-ts-col{flex:1 1 0;min-width:3px;max-width:46px;height:100%;display:flex;flex-direction:column;justify-content:flex-end;}
  .an-ts-x span{flex:1 1 0;min-width:3px;max-width:46px;text-align:center;overflow:hidden;}
  .an-ts-a{background:#34d399;border-radius:2px 2px 0 0;}
  .an-ts-b{background:#f87171;}
  .an-ts-x{display:flex;gap:2px;margin-top:6px;font-size:9px;color:var(--text-tertiary);}
</style>

<div class="an-grid-2">

  <div class="an-stack">
  <div class="an-card">
    <div class="an-title">Device distribution</div>
    <div class="an-row">
      <svg width="120" height="120" viewBox="0 0 120 120" style="flex:none;">
        <circle cx="60" cy="60" r="42" fill="none" stroke="var(--bg-input)" stroke-width="16"></circle>
        <% var offD = 0; stats.device.forEach(function(d, i){
             var len = (stats.grandTotal ? d.n/stats.grandTotal : 0) * CIRC; %>
          <circle cx="60" cy="60" r="42" fill="none" stroke="<%= PALETTE[i % PALETTE.length] %>"
            stroke-width="16" stroke-dasharray="<%= len.toFixed(2) %> <%= (CIRC-len).toFixed(2) %>"
            stroke-dashoffset="<%= (-offD).toFixed(2) %>" transform="rotate(-90 60 60)"><title><%= d._id || 'unknown' %>: <%= d.n %></title></circle>
          <% offD += len; %>
        <% }); %>
        <text x="60" y="57" text-anchor="middle" font-size="17" font-weight="700" fill="var(--text-primary)"><%= stats.grandTotal.toLocaleString() %></text>
        <text x="60" y="72" text-anchor="middle" font-size="9" fill="var(--text-tertiary)">clicks</text>
      </svg>
      <div class="an-legend">
        <% stats.device.forEach(function(d, i){ %>
          <div class="an-li">
            <span class="an-dot" style="background:<%= PALETTE[i % PALETTE.length] %>"></span>
            <span class="an-lbl"><%= d._id || 'unknown' %></span>
            <span class="an-val"><%= d.n.toLocaleString() %></span>
            <span class="an-pct"><%= pct(d.n, stats.grandTotal).toFixed(1) %>%</span>
          </div>
        <% }); %>
      </div>
    </div>
  </div>

  <div class="an-card">
    <div class="an-title">Allowed vs blocked</div>
    <div class="an-row">
      <svg width="120" height="120" viewBox="0 0 120 120" style="flex:none;">
        <circle cx="60" cy="60" r="42" fill="none" stroke="var(--bg-input)" stroke-width="16"></circle>
        <% var offC = 0; stats.decision.forEach(function(d){
             var len = (stats.grandTotal ? d.n/stats.grandTotal : 0) * CIRC; %>
          <circle cx="60" cy="60" r="42" fill="none" stroke="<%= decColors[d._id] || '#94a3b8' %>"
            stroke-width="16" stroke-dasharray="<%= len.toFixed(2) %> <%= (CIRC-len).toFixed(2) %>"
            stroke-dashoffset="<%= (-offC).toFixed(2) %>" transform="rotate(-90 60 60)"><title><%= d._id %>: <%= d.n %></title></circle>
          <% offC += len; %>
        <% }); %>
        <% var allowRow = null; stats.decision.forEach(function(x){ if (x._id === 'allow') allowRow = x; }); %>
        <text x="60" y="57" text-anchor="middle" font-size="17" font-weight="700" fill="#34d399"><%= pct(allowRow ? allowRow.n : 0, stats.grandTotal).toFixed(0) %>%</text>
        <text x="60" y="72" text-anchor="middle" font-size="9" fill="var(--text-tertiary)">allowed</text>
      </svg>
      <div class="an-legend">
        <% stats.decision.forEach(function(d){ %>
          <div class="an-li">
            <span class="an-dot" style="background:<%= decColors[d._id] || '#94a3b8' %>"></span>
            <span class="an-lbl"><%= d._id %></span>
            <span class="an-val"><%= d.n.toLocaleString() %></span>
            <span class="an-pct"><%= pct(d.n, stats.grandTotal).toFixed(1) %>%</span>
          </div>
        <% }); %>
      </div>
    </div>
  </div>
  </div>

  <div class="an-card">
    <div class="an-title">Traffic type</div>
    <% if (stats.ipType.length === 0) { %>
      <p class="muted" style="font-size:12px;">No enrichment data in this range.</p>
    <% } else { var maxT = 0; stats.ipType.forEach(function(x){ if (x.n > maxT) maxT = x.n; }); %>
      <% stats.ipType.forEach(function(t, i){ %>
        <div style="margin-bottom:9px;">
          <div style="display:flex;justify-content:space-between;font-size:12px;">
            <span class="an-lbl"><%= t._id || 'unknown' %></span>
            <span><span class="an-val"><%= t.n.toLocaleString() %></span>
              <span class="an-pct"><%= pct(t.n, stats.grandTotal).toFixed(1) %>%</span></span>
          </div>
          <div class="an-bar-track">
            <div class="an-bar-fill" style="width:<%= maxT ? (100*t.n/maxT) : 0 %>%;background:<%= PALETTE[i % PALETTE.length] %>"></div>
          </div>
        </div>
      <% }); %>
    <% } %>
  </div>
</div>

<div class="an-grid-3">

  <div class="an-card" style="order:2;">
    <div class="an-title">Top 5 countries</div>
    <% if (stats.country.length === 0) { %>
      <p class="muted" style="font-size:12px;">No country data in this range.</p>
    <% } else { var maxC = 0; stats.country.forEach(function(x){ if (x.n > maxC) maxC = x.n; }); %>
      <% stats.country.forEach(function(c){ %>
        <div style="margin-bottom:9px;">
          <div style="display:flex;justify-content:space-between;font-size:12px;">
            <span class="an-lbl"><strong><%= c._id || '—' %></strong>
              <span class="muted" style="font-size:11px;">(<%= c.allowed %> allowed)</span></span>
            <span><span class="an-val"><%= c.n.toLocaleString() %></span>
              <span class="an-pct"><%= pct(c.n, stats.grandTotal).toFixed(1) %>%</span></span>
          </div>
          <div class="an-bar-track" title="<%= c.allowed %> allowed of <%= c.n %>">
            <div style="height:100%;display:flex;width:<%= maxC ? (100*c.n/maxC) : 0 %>%;">
              <div style="background:#34d399;width:<%= c.n ? (100*c.allowed/c.n) : 0 %>%;"></div>
              <div style="background:#f87171;flex:1;"></div>
            </div>
          </div>
        </div>
      <% }); %>
      <div style="font-size:10px;color:var(--text-tertiary);margin-top:8px;">
        <span style="color:#34d399;">■</span> allowed &nbsp; <span style="color:#f87171;">■</span> blocked
      </div>
    <% } %>
  </div>

  <div class="an-card" style="order:1;">
    <div class="an-title">Top 5 traffic sources</div>
    <% if (!stats.source || stats.source.length === 0) { %>
      <p class="muted" style="font-size:12px;">No source data in this range.</p>
    <% } else { var maxS = 0; stats.source.forEach(function(x){ if (x.n > maxS) maxS = x.n; }); %>
      <% stats.source.forEach(function(sv, i){ %>
        <div style="margin-bottom:9px;">
          <div style="display:flex;justify-content:space-between;font-size:12px;">
            <span class="an-lbl" title="<%= sv._id %>"><strong><%= sv._id %></strong>
              <span class="muted" style="font-size:11px;">(<%= sv.allowed %> allowed)</span></span>
            <span><span class="an-val"><%= sv.n.toLocaleString() %></span>
              <span class="an-pct"><%= pct(sv.n, stats.grandTotal).toFixed(1) %>%</span></span>
          </div>
          <div class="an-bar-track" title="<%= sv.allowed %> allowed of <%= sv.n %>">
            <div style="height:100%;display:flex;width:<%= maxS ? (100*sv.n/maxS) : 0 %>%;">
              <div style="background:#34d399;width:<%= sv.n ? (100*sv.allowed/sv.n) : 0 %>%;"></div>
              <div style="background:#f87171;flex:1;"></div>
            </div>
          </div>
        </div>
      <% }); %>
      <div style="font-size:10px;color:var(--text-tertiary);margin-top:8px;">
        <span style="color:#34d399;">■</span> allowed &nbsp; <span style="color:#f87171;">■</span> blocked
      </div>
    <% } %>
  </div>

  <div class="an-card" style="order:3;">
    <div class="an-title">Top 5 campaigns</div>
    <% if (!stats.campaign || stats.campaign.length === 0) { %>
      <p class="muted" style="font-size:12px;">No campaign data in this range.</p>
    <% } else { var maxK = 0; stats.campaign.forEach(function(x){ if (x.n > maxK) maxK = x.n; }); %>
      <% stats.campaign.forEach(function(k){ %>
        <div style="margin-bottom:9px;">
          <div style="display:flex;justify-content:space-between;font-size:12px;">
            <span class="an-lbl" title="<%= k.label %>"><strong><%= k.label %></strong></span>
            <span><span class="an-val"><%= k.n.toLocaleString() %></span>
              <span class="an-pct"><%= pct(k.n, stats.grandTotal).toFixed(1) %>%</span></span>
          </div>
          <div class="an-bar-track" title="<%= k.allowed %> allowed · <%= k.would %> would_block · <%= k.blocked %> blocked">
            <div style="height:100%;display:flex;width:<%= maxK ? (100*k.n/maxK) : 0 %>%;">
              <div style="background:#34d399;width:<%= k.n ? (100*k.allowed/k.n) : 0 %>%;"></div>
              <div style="background:#fbbf24;width:<%= k.n ? (100*k.would/k.n) : 0 %>%;"></div>
              <div style="background:#f87171;flex:1;"></div>
            </div>
          </div>
        </div>
      <% }); %>
      <div style="font-size:10px;color:var(--text-tertiary);margin-top:8px;">
        <span style="color:#34d399;">■</span> allow &nbsp;
        <span style="color:#fbbf24;">■</span> would_block &nbsp;
        <span style="color:#f87171;">■</span> block
      </div>
    <% } %>
  </div>

  <div class="an-card" style="grid-column:1/-1;order:4;">
    <div class="an-title">Traffic over time (<%= stats.timeGranularity === 'hour' ? 'hourly' : 'daily' %>)</div>
    <% if (stats.time.length === 0) { %>
      <p class="muted" style="font-size:12px;">No data in this range.</p>
    <% } else {
         var maxTs = 0; stats.time.forEach(function(x){ if (x.total > maxTs) maxTs = x.total; });
         var step = Math.max(1, Math.ceil(stats.time.length / 12)); %>
      <div class="an-ts">
        <% stats.time.forEach(function(t){ %>
          <div class="an-ts-col" title="<%= t._id %> — <%= t.allowed %> allowed, <%= t.blocked %> blocked">
            <% var hB = maxTs ? (100*t.blocked/maxTs) : 0; var hA = maxTs ? (100*t.allowed/maxTs) : 0; %>
            <div class="an-ts-b" style="height:<%= (t.blocked > 0 && hB < 2) ? 2 : hB %>%;"></div>
            <div class="an-ts-a" style="height:<%= (t.allowed > 0 && hA < 2) ? 2 : hA %>%;"></div>
          </div>
        <% }); %>
      </div>
      <div class="an-ts-x">
        <% stats.time.forEach(function(t, i){ %>
          <span><%= (i % step === 0) ? String(t._id).replace(/^\d{4}-/, '') : '' %></span>
        <% }); %>
      </div>
      <div style="font-size:10px;color:var(--text-tertiary);margin-top:6px;">
        <span style="color:#34d399;">■</span> allowed &nbsp; <span style="color:#f87171;">■</span> blocked &nbsp;·&nbsp; peak <%= maxTs.toLocaleString() %>
      </div>
    <% } %>
  </div>

</div>
<% } %>

<% if (clicks.length === 0) { %>
  <div class="empty-state"><p>No clicks match these filters.</p></div>
<% } else { %>
  <div class="table-scroll"><table class="table table-dense">
    <tr>
      <th>Time</th>
      <th>Click ID</th>
      <th>Campaign</th>
      <th>UTM Source / Medium / Campaign</th>
      <th>IP</th>
      <th>Provider</th>
      <th>Type</th>
      <th>Country</th>
      <th>Device</th>
      <th>UA</th>
      <th>InApp</th>
      <th>Conv</th>
      <th>Decision</th>
    </tr>
    <% clicks.forEach(c => { %>
      <tr>
        <td><%- localTime(c.ts) %></td>
        <td><a href="/admin/clicks/<%= c.click_id %>"><code><%= c.click_id.slice(0, 12) %>…</code></a></td>
        <td class="cell-truncate-sm" title="<%= c.campaign_id?.name || '' %>"><%= c.campaign_id?.name || '–' %></td>
        <td class="cell-truncate-sm" title="<%= [c.utm?.source, c.utm?.medium, c.utm?.campaign].filter(Boolean).join(' / ') %>">
          <%= c.utm?.source || '–' %> / <%= c.utm?.medium || '–' %> / <%= c.utm?.campaign || '–' %>
        </td>
        <td><code><%= c.ip || '–' %></code></td>
        <td class="cell-truncate-sm" title="<%= [c.asn_org, c.organisation].filter(Boolean).join(' — ') || '' %>">
          <% if (c.asn_org) { %>
            <span style="display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"><%= c.asn_org %></span>
            <% if (c.asn) { %><small class="muted">AS<%= c.asn %></small><% } %>
          <% } else { %>–<% } %>
        </td>
        <td>
          <% if (c.is_proxy) { %>
            <span class="badge badge-block"><%= (c.proxy_type || 'PROXY').toLowerCase() %></span>
          <% } else if (c.ip_type) { %>
            <span class="badge badge-status-archived"><%= c.ip_type %></span>
          <% } else { %>–<% } %>
          <% if (c.hosting && !c.is_proxy) { %><br><small class="muted">hosting</small><% } %>
        </td>
        <td><% if (c.country) { %><span title="<%= c.country %>"><%= countryFlag(c.country) %> <%= c.country %></span><% } else { %>–<% } %></td>
        <td>
          <%= c.ua_parsed?.device_label || c.ua_parsed?.device_type || '–' %>
        </td>
        <td title="<%= c.user_agent %>">
          <%= c.ua_parsed?.browser || '–' %> / <%= c.ua_parsed?.os || '–' %>
          <% if (c.ua_parsed?.is_bot) { %><br><span class="badge badge-warn">bot-ish</span><% } %>
        </td>
        <td><%= c.in_app_browser || '–' %></td>
        <td>
          <% if (c.conversion_count > 0) { %>
            <span class="badge badge-allow"><%= c.conversion_count %></span>
            <% if (c.auto_conversion_count > 0) { %>
              <br><small class="muted" title="<%= c.auto_conversion_count %> auto-detected">auto</small>
            <% } %>
          <% } else { %>–<% } %>
        </td>
        <td><span class="badge badge-<%= c.decision %>"><%= c.decision %></span></td>
      </tr>
    <% }) %>
  </table></div>

  <%# Pagination control. Preserves all current filters via the form, so
      jumping pages doesn't lose the active query. The per-page selector
      auto-submits on change. The page number input is the only thing
      that's manually typed-and-submitted. %>
  <nav class="pagination" aria-label="Click log pagination">
    <% function paginationUrl(targetPage) {
         const params = new URLSearchParams(query);
         params.set('page_n', String(targetPage));
         params.set('per', String(perPage));
         return '/admin/clicks?' + params.toString();
       } %>

    <div class="pagination-controls">
      <% if (currentPage > 1) { %>
        <a href="<%= paginationUrl(1) %>" class="btn btn-small" title="First page">« First</a>
        <a href="<%= paginationUrl(currentPage - 1) %>" class="btn btn-small" rel="prev">‹ Prev</a>
      <% } else { %>
        <span class="btn btn-small disabled" aria-disabled="true">« First</span>
        <span class="btn btn-small disabled" aria-disabled="true">‹ Prev</span>
      <% } %>

      <span class="pagination-page-info">
        Page
        <form method="GET" action="/admin/clicks" style="display:inline">
          <%# Hidden inputs preserve every other filter. We deliberately
              forward `per` so a manually typed page number keeps the
              currently-selected per-page size. %>
          <% Object.entries(query).forEach(([k, v]) => { %>
            <% if (k !== 'page_n' && v !== '' && v != null) { %>
              <input type="hidden" name="<%= k %>" value="<%= v %>">
            <% } %>
          <% }) %>
          <input type="hidden" name="per" value="<%= perPage %>">
          <input type="number" name="page_n" value="<%= currentPage %>"
                 min="1" max="<%= totalPages %>"
                 style="width:70px; text-align:center;"
                 aria-label="Go to page number">
        </form>
        of <strong><%= totalPages.toLocaleString() %></strong>
      </span>

      <% if (currentPage < totalPages) { %>
        <a href="<%= paginationUrl(currentPage + 1) %>" class="btn btn-small" rel="next">Next ›</a>
        <a href="<%= paginationUrl(totalPages) %>" class="btn btn-small" title="Last page">Last »</a>
      <% } else { %>
        <span class="btn btn-small disabled" aria-disabled="true">Next ›</span>
        <span class="btn btn-small disabled" aria-disabled="true">Last »</span>
      <% } %>
    </div>

    <div class="pagination-per-page">
      <form method="GET" action="/admin/clicks" style="display:inline">
        <% Object.entries(query).forEach(([k, v]) => { %>
          <% if (k !== 'per' && k !== 'page_n' && v !== '' && v != null) { %>
            <input type="hidden" name="<%= k %>" value="<%= v %>">
          <% } %>
        <% }) %>
        <label class="muted" style="font-size:13px;">
          Per page:
          <select name="per" onchange="this.form.submit()">
            <% perPageOptions.forEach(n => { %>
              <option value="<%= n %>" <%= n === perPage ? 'selected' : '' %>><%= n %></option>
            <% }) %>
          </select>
        </label>
      </form>
    </div>
  </nav>
<% } %>

<%- include('../partials/footer') %>
